{"id": "rename-symbol", "task": "rename OLD_NAME to NEW_NAME in one file", "setup": {"src/a.py": "VALUE = 'OLD_NAME'\nprint(OLD_NAME)\n"}, "steps": [{"tool": "fs.patch", "args": {"path": "src/a.py", "edits": [{"old_text": "OLD_NAME", "new_text": "NEW_NAME", "replace_all": true}]}}], "expect": {"ok": true, "data": {"applied": 1, "failed": []}, "no_warnings": true}}
{"id": "rename-symbol-verify", "task": "rename a symbol and verify none remain", "setup": {"src/a.py": "VALUE = 'OLD_NAME'\nprint(OLD_NAME)\n"}, "steps": [{"tool": "fs.search", "args": {"pattern": "OLD_NAME"}}, {"tool": "fs.patch", "args": {"path": "src/a.py", "edits": [{"old_text": "OLD_NAME", "new_text": "NEW_NAME", "replace_all": true}]}}, {"tool": "fs.search", "args": {"pattern": "OLD_NAME"}}], "expect": {"ok": true, "data": {"count": 0, "total_matches": 0}, "no_warnings": true}}
{"id": "add-dependency-pip", "task": "add a dependency to requirements.txt", "setup": {"requirements.txt": "flask>=3.0\nrequests>=2.31\n"}, "steps": [{"tool": "fs.read", "args": {"path": "requirements.txt"}}, {"tool": "fs.patch", "args": {"path": "requirements.txt", "edits": [{"old_text": "requests>=2.31\n", "new_text": "requests>=2.31\nhttpx>=0.27\n"}]}}, {"tool": "fs.read", "args": {"path": "requirements.txt"}}], "expect": {"ok": true, "data": {"content": "flask>=3.0\nrequests>=2.31\nhttpx>=0.27\n"}, "no_warnings": true}}
{"id": "add-dependency-json", "task": "add a version field to package.json", "setup": {"package.json": "{\n  \"name\": \"demo\",\n  \"main\": \"index.js\"\n}\n"}, "steps": [{"tool": "fs.read", "args": {"path": "package.json"}}, {"tool": "fs.patch", "args": {"path": "package.json", "edits": [{"old_text": "\"name\": \"demo\",", "new_text": "\"name\": \"demo\",\n  \"version\": \"2.0.0\","}]}}, {"tool": "fs.search", "args": {"pattern": "2.0.0"}}], "expect": {"ok": true, "data": {"count": 1}, "no_warnings": true}}
{"id": "split-file", "task": "extract the second function into its own module", "setup": {"src/big.py": "def alpha():\n    return 1\n\n\ndef beta():\n    return 2\n"}, "steps": [{"tool": "fs.read", "args": {"path": "src/big.py"}}, {"tool": "fs.write", "args": {"path": "src/part2.py", "content": "def beta():\n    return 2\n"}}, {"tool": "fs.patch", "args": {"path": "src/big.py", "edits": [{"old_text": "def alpha():\n    return 1\n\n\ndef beta():\n    return 2\n", "new_text": "def alpha():\n    return 1\n"}]}}, {"tool": "fs.read", "args": {"path": "src/big.py"}}], "expect": {"ok": true, "data": {"content": "def alpha():\n    return 1\n"}, "no_warnings": true}}
{"id": "split-file-verify", "task": "after the split, the extracted module has the right size", "setup": {"src/big.py": "def alpha():\n    return 1\n\n\ndef beta():\n    return 2\n"}, "steps": [{"tool": "fs.read", "args": {"path": "src/big.py"}}, {"tool": "fs.write", "args": {"path": "src/part2.py", "content": "def beta():\n    return 2\n"}}, {"tool": "fs.patch", "args": {"path": "src/big.py", "edits": [{"old_text": "def alpha():\n    return 1\n\n\ndef beta():\n    return 2\n", "new_text": "def alpha():\n    return 1\n"}]}}, {"tool": "fs.stat", "args": {"path": "src/part2.py"}}], "expect": {"ok": true, "data": {"size": 25, "is_file": true}, "no_warnings": true}}
{"id": "fix-crlf", "task": "rewrite a CRLF-corrupted file with LF", "setup": {"note.txt": "line one\r\nline two\r\n"}, "steps": [{"tool": "fs.read", "args": {"path": "note.txt"}}, {"tool": "fs.write", "args": {"path": "note.txt", "content": "line one\nline two\n", "newline": "lf"}}, {"tool": "fs.read", "args": {"path": "note.txt"}}], "expect": {"ok": true, "data": {"newline": "lf", "content": "line one\nline two\n"}, "no_warnings": true}}
{"id": "fix-crlf-stat", "task": "CRLF to LF shrinks the file", "setup": {"note.txt": "line one\r\nline two\r\n"}, "steps": [{"tool": "fs.stat", "args": {"path": "note.txt"}}, {"tool": "fs.write", "args": {"path": "note.txt", "content": "line one\nline two\n", "newline": "lf"}}, {"tool": "fs.stat", "args": {"path": "note.txt"}}], "expect": {"ok": true, "data": {"size": 18}, "no_warnings": true}}
{"id": "find-secret-leak", "task": "find a hardcoded AWS key", "setup": {"src/db.py": "KEY = \"AKIAQ4W7E2XK9M3B1D5F\"\n"}, "steps": [{"tool": "fs.glob", "args": {"pattern": "src/*.py"}}, {"tool": "fs.search", "args": {"pattern": "AKIA"}}], "expect": {"ok": true, "data": {"count": 1, "files_matched": 1}, "no_warnings": true}}
{"id": "find-secret-regex", "task": "find the key with a shape-matching regex", "setup": {"src/db.py": "KEY = \"AKIAQ4W7E2XK9M3B1D5F\"\n"}, "steps": [{"tool": "fs.search", "args": {"pattern": "AKIA[0-9A-Z]{16}", "regex": true}}], "expect": {"ok": true, "data": {"count": 1}, "no_warnings": true}}
{"id": "rotate-leaked-key", "task": "replace the leaked key with an env lookup", "setup": {"src/db.py": "KEY = \"AKIAQ4W7E2XK9M3B1D5F\"\n"}, "steps": [{"tool": "fs.search", "args": {"pattern": "AKIA"}}, {"tool": "fs.patch", "args": {"path": "src/db.py", "edits": [{"old_text": "KEY = \"AKIAQ4W7E2XK9M3B1D5F\"", "new_text": "KEY = os.environ[\"DB_KEY\"]"}]}}, {"tool": "fs.search", "args": {"pattern": "AKIA"}}], "expect": {"ok": true, "data": {"count": 0}, "no_warnings": true}}
{"id": "background-build-watch", "task": "background a build and watch for its OK line", "setup": {}, "steps": [{"tool": "shell.run", "args": {"script": "sleep 1; echo BUILD OK", "dialect": "bash", "background": true}}, {"tool": "shell.job_watch", "args": {"job_id": "$1.data.job_id", "until": "BUILD OK", "timeout_s": 30, "poll_s": 0.1}}], "expect": {"ok": true, "data": {"matched_line": "BUILD OK", "timed_out": false}}}
{"id": "background-build-wait", "task": "background a build and wait for its exit", "setup": {}, "steps": [{"tool": "shell.run", "args": {"script": "sleep 1; echo done", "dialect": "bash", "background": true}}, {"tool": "shell.job_wait", "args": {"job_id": "$1.data.job_id", "timeout_s": 30}}], "expect": {"ok": true, "data": {"running": false, "exit_code": 0}}}
{"id": "undo-bad-batch", "task": "revert a batch edit that went too far", "setup": {"src/a.py": "GOOD = 1\nBAD = 2\n"}, "steps": [{"tool": "fs.patch", "args": {"path": "src/a.py", "edits": [{"old_text": "GOOD = 1\nBAD = 2\n", "new_text": "GOOD = 1\n"}]}}, {"tool": "fs.undo_task", "args": {"task_id": "undo-bad-batch"}}, {"tool": "fs.read", "args": {"path": "src/a.py"}}], "expect": {"ok": true, "data": {"content": "GOOD = 1\nBAD = 2\n"}, "no_warnings": true}}
{"id": "undo-batch-verify", "task": "after the undo, the removed line is back", "setup": {"src/a.py": "GOOD = 1\nBAD = 2\n"}, "steps": [{"tool": "fs.patch", "args": {"path": "src/a.py", "edits": [{"old_text": "GOOD = 1\nBAD = 2\n", "new_text": "GOOD = 1\n"}]}}, {"tool": "fs.undo_task", "args": {"task_id": "undo-batch-verify"}}, {"tool": "fs.search", "args": {"pattern": "BAD = 2"}}], "expect": {"ok": true, "data": {"count": 1}, "no_warnings": true}}
{"id": "move-rename", "task": "rename a file and confirm the old path is gone", "setup": {"src/old_name.py": "x = 1\n"}, "steps": [{"tool": "fs.move", "args": {"src": "src/old_name.py", "dst": "src/new_name.py"}}, {"tool": "fs.read", "args": {"path": "src/new_name.py"}}, {"tool": "fs.stat", "args": {"path": "src/old_name.py"}}], "expect": {"ok": true, "data": {"exists": false, "is_file": false}, "no_warnings": true}}
{"id": "mkdir-tree", "task": "create a nested directory tree", "setup": {}, "steps": [{"tool": "fs.mkdir", "args": {"path": "docs/api/v2", "parents": true}}, {"tool": "fs.list", "args": {"path": "docs/api"}}], "expect": {"ok": true, "data": {"count": 1}, "no_warnings": true}}
{"id": "delete-tidy", "task": "delete a scratch file and confirm it is gone", "setup": {}, "steps": [{"tool": "fs.write", "args": {"path": "tmp/scratch.txt", "content": "junk\n"}}, {"tool": "fs.delete", "args": {"path": "tmp/scratch.txt"}}, {"tool": "fs.stat", "args": {"path": "tmp/scratch.txt"}}], "expect": {"ok": true, "data": {"exists": false}, "no_warnings": true}}
{"id": "chmod-exec", "task": "make a script executable", "setup": {}, "steps": [{"tool": "fs.write", "args": {"path": "bin/run.sh", "content": "#!/bin/sh\necho hi\n"}}, {"tool": "fs.chmod", "args": {"path": "bin/run.sh", "mode": "0o755"}}], "expect": {"ok": true, "data": {"mode": "0o755", "changed": true}, "no_warnings": true}}
{"id": "glob-report", "task": "count the python files under src", "setup": {"src/a.py": "a\n", "src/b.py": "b\n", "pkg/c.py": "c\n"}, "steps": [{"tool": "fs.glob", "args": {"pattern": "src/**/*.py"}}], "expect": {"ok": true, "data": {"count": 2}, "no_warnings": true}}
{"id": "search-ignore-case", "task": "case-insensitive search", "setup": {"docs/text.md": "Hello World\nhello again\nHELLO there\n"}, "steps": [{"tool": "fs.search", "args": {"pattern": "hello", "ignore_case": true}}], "expect": {"ok": true, "data": {"count": 3}, "no_warnings": true}}
{"id": "stat-check", "task": "stat a freshly written file", "setup": {}, "steps": [{"tool": "fs.write", "args": {"path": "data/blob.txt", "content": "0123456789"}}, {"tool": "fs.stat", "args": {"path": "data/blob.txt"}}], "expect": {"ok": true, "data": {"size": 10, "exists": true, "is_file": true}, "no_warnings": true}}
{"id": "write-create-dirs", "task": "write a file whose parent directories do not exist yet", "setup": {}, "steps": [{"tool": "fs.write", "args": {"path": "deep/nested/file.txt", "content": "here\n"}}, {"tool": "fs.read", "args": {"path": "deep/nested/file.txt"}}], "expect": {"ok": true, "data": {"content": "here\n"}, "no_warnings": true}}
{"id": "read-offset", "task": "read only the first line of a long file", "setup": {"src/long.py": "first\nsecond\nthird\n"}, "steps": [{"tool": "fs.read", "args": {"path": "src/long.py", "limit_lines": 1}}], "expect": {"ok": true, "data": {"content": "first\n", "lines": 1}, "no_warnings": true}}
{"id": "patch-retry-recovery", "task": "a bad patch anchor fails; reread and patch correctly", "setup": {"src/a.py": "TARGET = 1\n"}, "steps": [{"tool": "fs.patch", "args": {"path": "src/a.py", "edits": [{"old_text": "NONEXISTENT_ANCHOR", "new_text": "x"}]}}, {"tool": "fs.read", "args": {"path": "src/a.py"}}, {"tool": "fs.patch", "args": {"path": "src/a.py", "edits": [{"old_text": "TARGET = 1", "new_text": "TARGET = 2"}]}}], "expect": {"ok": true, "data": {"applied": 1, "failed": []}}}
